header stdio::printf;
header stdio::scanf;

func main() -> i32 {
    let mut i : i32 = 0;
    printf("echo any positive integer, 0 to exit");
    loop {
        scanf("%d", &i);

        if i == 0{
            printf("exiting...");
            break;
        }
        else{
            printf("%d\n", i);
        }
    }

    return 0;
}
