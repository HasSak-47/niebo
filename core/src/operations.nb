import core::traits::{Add, Neg, Sub, Mul, Div, Eq, NEq, LEq, GEq, Les, Gre, Copy};

extend i8 as Copy {
    fn copy(self: i8) -> i8 { return @copy(self); }
}

extend i8 as Neg {
    fn neg(self: i8) -> i8 { return @neg_i8(self); }
}

extend i8 as Add {
    fn add(self: i8, other: i8) -> i8 { return @add_i8(self, other); }
}

extend i8 as Sub {
    fn sub(self: i8, other: i8) -> i8 { return @sub_i8(self, other); }
}

extend i8 as Mul {
    fn mul(self: i8, other: i8) -> i8 { return @mul_i8(self, other); }
}

extend i8 as Div {
    fn div(self: i8, other: i8) -> i8 { return @div_i8(self, other); }
}

extend i8 as Eq {
    fn eq(self: i8, other: i8) -> bool { return @eq_i8(self, other); }
}

extend i8 as NEq {
    fn neq(self: i8, other: i8) -> bool { return @neq_i8(self, other); }
}

extend i8 as LEq {
    fn leq(self: i8, other: i8) -> bool { return @leq_i8(self, other); }
}

extend i8 as GEq {
    fn geq(self: i8, other: i8) -> bool { return @geq_i8(self, other); }
}

extend i8 as Les {
    fn les(self: i8, other: i8) -> bool { return @les_i8(self, other); }
}

extend i8 as Gre {
    fn gre(self: i8, other: i8) -> bool { return @gre_i8(self, other); }
}

