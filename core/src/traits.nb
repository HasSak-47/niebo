pub mod i32;

pub inter Copy {
     func copy(&self) -> Self;
}

pub inter Add<T, R> {
    func add(self, other: T) -> T;
}

pub inter Sub<T, R> {
    func sub(self, other: T) -> R;
}

pub inter Mul<T, R> {
    func mul(self, other: T) -> R;
}

pub inter Div<T, R> {
    func div(self, other: T) -> R;
}
